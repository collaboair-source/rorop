# ---- 기존 앱 ----
JWT_SECRET=change-me

# ---- 지원사업 크롤러 / AI 매칭 ----
# 기업마당(bizinfo.go.kr) Open API 인증키. 없으면 목록 HTML 파싱으로 동작(불안정).
# 발급: bizinfo.go.kr 로그인 > 마이페이지 > Open API 인증키 신청
BIZINFO_API_KEY=

# 공공데이터포털(data.go.kr) 서비스키 — "창업진흥원_K-Startup 창업지원사업 공고 정보" 활용신청 후 발급.
# 인코딩/디코딩 키 어느 쪽을 넣어도 된다. 없으면 K-Startup 목록 HTML 파싱으로 동작(불안정).
DATA_GO_KR_SERVICE_KEY=

# Claude API 키 (AI 적합도 분석 + 지원 가이드). 없으면 규칙 기반 점수만 동작.
ANTHROPIC_API_KEY=
# 분석 모델 (기본 claude-opus-5)
SUPPORT_AI_MODEL=claude-opus-5
# 크롤링 직후 신규 공고 중 규칙 점수 상위 N건을 자동 AI 분석 (0 = 끔)
SUPPORT_AI_AUTO_ANALYZE_TOP_N=0
SUPPORT_AI_AUTO_ANALYZE_MIN_SCORE=50

# 스케줄러(Vercel Cron / 외부 cron) 가 /api/support/crawl 를 호출할 때 쓰는 비밀값
CRON_SECRET=

# 주간 요약을 받을 Slack/Discord Incoming Webhook URL (선택)
NOTIFY_WEBHOOK_URL=
# 알림 링크에 쓸 앱 주소 (선택, 예: https://myapp.vercel.app)
APP_URL=

# 데이터 파일 저장 위치 (기본 ./data). 서버리스(읽기 전용 FS)에서는 /tmp 등으로.
SUPPORT_DATA_DIR=
